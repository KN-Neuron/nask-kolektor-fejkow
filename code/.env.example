META_ACCESS_TOKEN=
META_API_VERSION=
LLM_API_KEY=
LLM_PROVIDER=anthropic
YOUTUBE_API_KEY=
HASH_SALT=
CERT_BASE_URL=https://hole.cert.pl/domains/v2/
# LLM generator: LLM_PROVIDER=ollama (local, free, default) | deepseek | kimi | openai_compat | anthropic
# ollama: LLM_MODEL=gemma2 ; deepseek/kimi need LLM_API_KEY ; openai_compat needs LLM_BASE_URL and LLM_MODEL
LLM_MODEL=
LLM_BASE_URL=
GCP_PROJECT=
URLSCAN_API_KEY=
# urlscan.io: darmowe konto → Settings → API Keys; bez klucza działa wyszukiwarka i zrzuty, z kluczem także pełne wyniki i DOM

# Neo4j (docker compose); użytkownik: neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
